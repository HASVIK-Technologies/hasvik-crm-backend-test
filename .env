PORT=4000
SUPERADMIN_EMAIL=admin@hasviktech.com
# MONGO_URI
MONGO_URI=mongodb://localhost:27017/crm

# sms_servic
CB_SMS=true
SMS_PROVIDER=TWILIO

JWT_ACCESS_SECRET=your-super-secret-key-change-this
JWT_REFRESH_SECRET=secret

# Enable or disable audit log persistence
AUDIT_LOG_ENABLED=true

#Enable or disable notification service
CB_NOTIFICATION_SERVICE=false

NOTIFICATION_TRANSPORT=REST

# Add these to CRM deployment environment (never commit real secrets)
NOTIFICATION_SERVICE_URL=https://hasvik-notification-service-nu.vercel.app
NOTIFICATION_SERVICE_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET_1
REMINDER_LOOKBACK_DAYS=30
REMINDER_BATCH_SIZE=50